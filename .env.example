# ==========================================
# Online Bay Bakery - Environment Template (.env.example)
# Rename this file to .env and configure your credentials
# ==========================================

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=online_bay_bakery

# Base Application URL
APP_URL=http://localhost/online_bay_bakery

# Gmail SMTP Configuration (Password Reset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME="Online Bay Bakery"

# Twilio SMS Configuration (Order SMS Notifications)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
TWILIO_ADMIN_PHONE=your_admin_phone_number
